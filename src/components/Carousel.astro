---
import { Icon } from '@astrojs/starlight/components';

interface Slide {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	slides: Slide[];
}

const { slides } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<div class="cpx-carousel" data-carousel={uid}>
	<div class="cpx-carousel-track" tabindex="0">
		{slides.map((slide) => (
			<div class="cpx-carousel-slide">
				<img src={slide.src} alt={slide.alt} loading="lazy" />
				{slide.caption && <p class="cpx-carousel-caption">{slide.caption}</p>}
			</div>
		))}
	</div>

	<button type="button" class="cpx-carousel-btn prev" aria-label="Précédent">
		<Icon name="left-arrow" />
	</button>
	<button type="button" class="cpx-carousel-btn next" aria-label="Suivant">
		<Icon name="right-arrow" />
	</button>

	<div class="cpx-carousel-dots">
		{slides.map((_, i) => <button type="button" class="cpx-carousel-dot" data-index={i} aria-label={`Aller à l'image ${i + 1}`} />)}
	</div>
</div>

<style>
	.cpx-carousel {
		position: relative;
		margin-block: 1.5rem;
	}

	.cpx-carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		gap: 0;
		border-radius: 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		scrollbar-width: none;
	}
	.cpx-carousel-track::-webkit-scrollbar {
		display: none;
	}

	.cpx-carousel-slide {
		flex: 0 0 100%;
		scroll-snap-align: center;
	}

	.cpx-carousel-slide img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.cpx-carousel-caption {
		margin: 0;
		padding: 0.5rem 0.9rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		background: var(--cpx-card-bg);
	}

	.cpx-carousel-btn {
		appearance: none;
		-webkit-appearance: none;
		position: absolute;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		color: white;
		cursor: pointer;
		z-index: 1;
	}
	.cpx-carousel-btn svg {
		filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.8));
	}
	.cpx-carousel-btn.prev {
		left: 0;
	}
	.cpx-carousel-btn.next {
		right: 0;
	}

	.cpx-carousel-dots {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}
	.cpx-carousel-dot {
		appearance: none;
		-webkit-appearance: none;
		display: block;
		flex: 0 0 auto;
		box-sizing: border-box;
		width: 0.5rem;
		height: 0.5rem;
		min-width: 0;
		min-height: 0;
		line-height: 0;
		border-radius: 999px;
		border: none;
		outline-offset: 2px;
		background: var(--sl-color-gray-4);
		cursor: pointer;
		padding: 0;
		margin: 0;
	}
	.cpx-carousel-dot[aria-current='true'] {
		background: var(--cpx-gold-500);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.cpx-carousel').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('.cpx-carousel-track');
		const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.cpx-carousel-dot'));
		const prevBtn = carousel.querySelector<HTMLButtonElement>('.cpx-carousel-btn.prev');
		const nextBtn = carousel.querySelector<HTMLButtonElement>('.cpx-carousel-btn.next');
		if (!track) return;

		const scrollToIndex = (i: number) => {
			const slide = track.children[i] as HTMLElement | undefined;
			if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
		};

		const updateDots = () => {
			const index = Math.round(track.scrollLeft / track.clientWidth);
			dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
		};

		prevBtn?.addEventListener('click', () => {
			const index = Math.round(track.scrollLeft / track.clientWidth);
			scrollToIndex(Math.max(0, index - 1));
		});
		nextBtn?.addEventListener('click', () => {
			const index = Math.round(track.scrollLeft / track.clientWidth);
			scrollToIndex(Math.min(track.children.length - 1, index + 1));
		});
		dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToIndex(i)));

		track.addEventListener('scroll', () => updateDots(), { passive: true });
		updateDots();
	});
</script>
